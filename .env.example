# Copy to .env and set a private database password. start.ps1 generates one on first use.
DB_PASSWORD=change-this-before-use
# Optional settings are inherited by the Java process.
# DB_URL=jdbc:postgresql://127.0.0.1:55432/schedule
# DB_USER=schedule
# AI_API_KEY=
# Optional: base64-encoded random 32-byte master key
# AI_CONFIG_MASTER_KEY=
# AI_CONFIG_KEY_FILE=.runtime/secrets/model-config.key
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=your-model
# ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
# SCHEDULE_SECURE_COOKIE=false
